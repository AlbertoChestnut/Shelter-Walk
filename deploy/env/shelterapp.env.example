# /etc/shelterapp/env  (chmod 600, owned by root; loaded by shelterapp.service)
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=login.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://login.example.org
SITE_URL=https://login.example.org
DOGWALK_APP_URL=https://app.example.org
DJANGO_DB_PATH=/opt/shelterapp/data/db.sqlite3
DJANGO_TIME_ZONE=America/New_York
DJANGO_BEHIND_PROXY=1
# Only when every request really arrives through Cloudflare (firewall admits
# only Cloudflare on 80/443); otherwise leave unset.
ALLAUTH_TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP
# Cookie shared by the login site and the app (leading dot, your parent domain)
SESSION_COOKIE_DOMAIN=.example.org
# Email (codes are printed to the console if EMAIL_HOST is empty)
DJANGO_FROM_EMAIL=Shelter Volunteers <no-reply@example.org>
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Server-to-server calls to the app (account deletion, etc.)
DOGWALK_API_URL=http://127.0.0.1:3000
DOGWALK_INTERNAL_TOKEN=same-value-as-INTERNAL_API_TOKEN
