(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# camera=(self) since the dog-walk app's QR scanner needs it on its
		# own origin; geolocation/microphone aren't used by either app.
		Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
		X-Frame-Options SAMEORIGIN
		-Server
	}
}

shelterwalk.com {
	encode gzip
	import security_headers

	# The PWA manifest and its icons have to be reachable without a session
	# cookie -- Chrome's "Install app" criteria fetches them itself and
	# doesn't reliably do so as an authenticated request, so gating them
	# (like the rest of the app) silently broke the install prompt. Neither
	# contains anything sensitive.
	handle /manifest.json {
		reverse_proxy 127.0.0.1:3000
	}
	handle /icons/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		# Every other request must be authenticated by your own sign-in
		# service first (not included in this repo). It must expose an
		# endpoint that returns 2xx for a signed-in visitor and a non-2xx
		# otherwise, and set these two response headers on success so Caddy
		# forwards them to the app below:
		#   X-Auth-Email  a stable identifier for the signed-in account, an
		#                 email or any placeholder (the app trusts this
		#                 completely, so nothing but Caddy may ever set it)
		#   X-Auth-Staff  "1" for staff/admin accounts, otherwise absent
		forward_auth 127.0.0.1:8001 {
			uri /internal/authcheck/
			copy_headers X-Auth-Email X-Auth-Staff
		}
		reverse_proxy 127.0.0.1:3000
	}
}
