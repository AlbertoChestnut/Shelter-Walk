# /etc/dogwalk/env  (chmod 600, owned by root; loaded by dogwalk.service)
# Shared secret your auth service uses to call the app server-to-server. Must be
# identical to the bearer token it sends. Generate with:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=change-me
# Web push keys. Generate a pair with:  npx web-push generate-vapid-keys
# Push notifications are simply disabled if these are empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org
# Secret for the one-way hash the app keeps in place of an email address.
# Generate once with `openssl rand -hex 32` and NEVER change or lose it, or
# every existing account stops resolving on its next sign-in. Keep a copy
# somewhere safe outside this server (a password manager), next to your
# offsite backups: restoring a database backup is no use without it.
EMAIL_HASH_PEPPER=change-me
# Optional settings (defaults in brackets; see the README's env table):
# BIND_HOST=127.0.0.1   keep it on loopback; the app trusts X-Auth-* headers
# DB_PATH=              [app/data/dogwalk.db]
# IMAGES_DIR=           [app/data/images]
# WIKI_IMAGES_DIR=      [app/data/wiki-images]
# WALK_HOURS=07:00-19:00   default walking hours when staff haven't set any
# LINK_ACCOUNTS_BY_NAME=   leave unset; "1" is a one-time migration aid that
#                          lets a sign-in claim an unlinked profile by name
