[Unit]
Description=Shelter volunteer app (Django/gunicorn)
After=network.target

[Service]
Type=simple
User=shelterapp
Group=shelterapp
WorkingDirectory=/opt/shelterapp/app
EnvironmentFile=/etc/shelterapp/env
ExecStart=/opt/shelterapp/app/.venv/bin/gunicorn shelter.wsgi:application \
    --bind 127.0.0.1:8001 \
    --workers 2 \
    --timeout 30 \
    --no-control-socket \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/shelterapp/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
